# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Secrets & environment (NEVER commit) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# Block all .env variants except the template
.env*
!.env.example

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build output ---
/.next/
/out/
/build
/dist

# --- PWA generated files (rebuilt on npm run build) ---
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/fallback-*.js
/public/swe-worker-*.js

# --- Vercel ---
.vercel

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Testing ---
/coverage
*.lcov
.nyc_output

# --- Debug & logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editor / IDE (local settings only) ---
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# VS Code — ignore local user settings, keep shared config if you add it later
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Cursor ---
.cursor/

# --- SSL / keys ---
*.pem
*.key
*.crt
*.p12

# --- Cache & temp ---
.cache/
.temp/
.tmp/
*.tmp
.turbo/
.swc/

# --- Misc ---
*.local
*.bak
*.orig
